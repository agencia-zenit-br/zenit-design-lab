{
  "name": "zenit-design-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:design && npm run test:temporal && npm run test:operational && tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:design": "node scripts/check-design-contract.mjs && node --test scripts/check-preview-cd.test.mjs",
    "check:browser": "node scripts/check-browser-layout.mjs",
    "test:temporal": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test scripts/temporal.test.mjs",
    "test:operational": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test scripts/operational.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "storybook": "^8.6.0",
    "typescript": "^5.7.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  }
}
